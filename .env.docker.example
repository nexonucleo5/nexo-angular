# Copie para .env.docker e preencha:  cp .env.docker.example .env.docker
# Uso: docker compose --env-file .env.docker up -d --build

# ── Obrigatório ──
# openssl rand -base64 48
NEXO_JWT_SECRET=
POSTGRES_PASSWORD=

# ── Opcionais ──
POSTGRES_DB=nexo
POSTGRES_USER=nexo
# Porta do site no host
FRONT_PORT=4200
# Semeia dados de exemplo (logins aluno/professor/diretor, senha 123456)
SEED_ENABLED=true

# ── Imagens / registry (veja scripts/docker-publish.*) ──
DOCKERHUB_USER=nexonucleo5
TAG=latest
