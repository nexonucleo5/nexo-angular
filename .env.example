# Copie para .env e preencha. O .env é local, não vai pro git.
# O backend lê este arquivo via spring.config.import (application.yml).
#
# Windows: salve sem BOM. O `Set-Content -Encoding utf8` do PowerShell 5.1
# escreve BOM, e aí a primeira chave do arquivo é lida com lixo na frente —
# o app não acha NEXO_JWT_SECRET e não sobe.

# ── Obrigatório ──────────────────────────────────────────────────────────────
# Chave de assinatura dos access tokens. Mínimo 32 caracteres (HMAC-SHA precisa
# de 256 bits) — o app se recusa a subir com menos.
#   openssl rand -base64 48
NEXO_JWT_SECRET=

# ── Desenvolvimento local ────────────────────────────────────────────────────
# Estas duas nascem DESLIGADAS no application.yml e se ligam aqui. A inversão é
# proposital: o .env é local e nunca entra na imagem (ver .dockerignore), então
# ligar aqui vale só na sua máquina e um container jamais herda.
#
# Antes elas eram `true` fixo no application.yml, que é o que vale quando nenhum
# perfil é ativado — e nem o Dockerfile nem o compose ativavam um. Resultado: todo
# container subia publicando o console do H2 e com contas de senha conhecida.

# Popula o banco vazio com turmas, matérias e as contas de exemplo
# (admin, diretor, professor, aluno — todas com a senha 123456).
SEED_ENABLED=true
# Console web do H2 em /h2-console. Dá acesso total ao banco com nexo/nexo.
H2_CONSOLE_ENABLED=true

# PORT=8080

# ── Só em produção (perfil prod, definidos no painel do Render) ──────────────
# DB_URL=jdbc:postgresql://host:5432/nexo
# DB_USER=
# DB_PASSWORD=
# CORS_ORIGINS=https://nexo-gestao-escolar.com.br
# SEED_ENABLED=false
