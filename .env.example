# Copie para .env e preencha. O .env é local, não vai pro git.
# O backend lê este arquivo via spring.config.import (application.yml).
#
# Windows: salve sem BOM. O `Set-Content -Encoding utf8` do PowerShell 5.1
# escreve BOM, e aí a primeira chave do arquivo é lida com lixo na frente —
# o app não acha NEXO_JWT_SECRET e não sobe.

# ── Obrigatório ──────────────────────────────────────────────────────────────
# Chave de assinatura dos access tokens. Mínimo 32 caracteres (HMAC-SHA precisa
# de 256 bits) — o app se recusa a subir com menos.
#   openssl rand -base64 48
NEXO_JWT_SECRET=

# ── Docker (compose.yaml) ────────────────────────────────────────────────────
# Senha do PostgreSQL do container. Obrigatória no `docker compose up`.
POSTGRES_PASSWORD=
# POSTGRES_DB=nexo
# POSTGRES_USER=nexo
# DB_PORT=5432            # porta do banco na sua máquina (só 127.0.0.1)
# FRONTEND_PORT=8080      # porta do site; o CORS acompanha sozinho
# SEED_ENABLED=true       # dados de exemplo no banco novo; false em instalação real

# Nome das imagens: <IMAGE_REGISTRY>/<IMAGE_NAMESPACE>/nexo-<serviço>:<NEXO_TAG>
#   Docker Hub:        IMAGE_REGISTRY=docker.io      IMAGE_NAMESPACE=<seu-usuario>
#   Registry local:    IMAGE_REGISTRY=localhost:5000 IMAGE_NAMESPACE=nexo
# IMAGE_REGISTRY=docker.io
# IMAGE_NAMESPACE=nexo
# NEXO_TAG=latest

# ── Opcionais em dev (têm default no application.yml) ────────────────────────
# PORT=8080

# ── Só em produção (perfil prod, definidos no painel do Render) ──────────────
# DB_URL=jdbc:postgresql://host:5432/nexo
# DB_USER=
# DB_PASSWORD=
# CORS_ORIGINS=https://nexo-gestao-escolar.com.br
# SEED_ENABLED=false
