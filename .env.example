# Copie para .env e preencha. O .env é local, não vai pro git.
# O backend lê este arquivo via spring.config.import (application.yml).
#
# Windows: salve sem BOM. O `Set-Content -Encoding utf8` do PowerShell 5.1
# escreve BOM, e aí a primeira chave do arquivo é lida com lixo na frente —
# o app não acha NEXO_JWT_SECRET e não sobe.

# ── Obrigatório ──────────────────────────────────────────────────────────────
# Chave de assinatura dos access tokens. Mínimo 32 caracteres (HMAC-SHA precisa
# de 256 bits) — o app se recusa a subir com menos.
#   openssl rand -base64 48
NEXO_JWT_SECRET=

# ── Perfil ───────────────────────────────────────────────────────────────────
# Não vai aqui: o Spring lê este arquivo depois de já ter decidido quais perfis
# estão ativos, então SPRING_PROFILES_ACTIVE definido no .env não tem efeito.
# Passe o perfil na hora de rodar:
#
#   mvn spring-boot:run -Dspring-boot.run.profiles=dev
#   $env:SPRING_PROFILES_ACTIVE = "dev"     (PowerShell, antes de subir a app)
#
# Sem perfil a aplicação sobe segura e vazia: sem console do H2 e sem as contas
# de exemplo. O `dev` liga as duas coisas (application-dev.yml); a imagem Docker
# já vem com `prod` e o compose.yaml sobrescreve para `dev`.

# ── Opcionais em dev (têm default no application.yml) ────────────────────────
# PORT=8080

# ── E-mail (opcional em dev) ─────────────────────────────────────────────────
# Sem SPRING_MAIL_HOST não há envio: o e-mail sai no log da aplicação, que é como
# se lê o link de recuperação de senha em desenvolvimento — procure por
# "E-mail não enviado". Para enviar de verdade, qualquer provedor SMTP serve.
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# EMAIL_REMETENTE=nao-responda@seu-dominio.com.br
# EMAIL_URL_BASE=http://localhost:4200

# ── Só em produção (perfil prod, definidos no painel do Render) ──────────────
# DB_URL=jdbc:postgresql://host:5432/nexo
# DB_USER=
# DB_PASSWORD=
# CORS_ORIGINS=https://nexo-gestao-escolar.com.br
# SEED_ENABLED=false
